{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gene",
  "type": "object",
  "properties": {
    "geneId": { "type": "string" },
    "symbol": { "type": "string" },
    "name": { "type": "string" },
    "chromosome": { "type": "string" },
    "summary": { "type": "string" },
    "hgncId": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["geneId", "symbol", "name"]
}
