{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClinicalTrial",
  "type": "object",
  "properties": {
    "trialId": { "type": "string" },
    "title": { "type": "string" },
    "phase": { "type": "string" },
    "status": { "type": "string" },
    "conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "enrollmentCriteria": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["trialId", "title", "phase", "status"]
}
